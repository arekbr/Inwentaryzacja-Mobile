# MariaDB — baza `zbiory` (wspólna z desktopem)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=mariadb
MARIADB_DATABASE=zbiory

# Claude API — potrzebne dla /api/v1/identify (Opus 4.7)
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token — apka mobilna wysyła w nagłówku Authorization: Bearer <token>
API_TOKEN=change-me-to-secure-random-string
