# Środowisko: "development" (domyślne) lub "production".
# production: brak /docs, brak /redoc, blokada DEV_MOCK_IDENTIFY=true.
ENVIRONMENT=development

# MariaDB — baza `zbiory` (wspólna z desktopem). PASSWORD WYMAGANE.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=CHANGE_ME_required
MARIADB_DATABASE=zbiory

# Claude API — wymagane dla /api/v1/identify gdy DEV_MOCK_IDENTIFY=false (czyli w prod).
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token — apka mobilna wysyła w nagłówku Authorization: Bearer <token>.
# WYMAGANE (brak = startup fail). Min 16 znaków. W prod użyj silnego losowego:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-strong-random-string

# Dev mode — /identify zwraca cached mock bez wołania Anthropic (oszczędza $).
# W production zabronione (startup fail).
DEV_MOCK_IDENTIFY=false
